<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net48;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <Authors>EomTaeWook</Authors>
    <Nullable>disable</Nullable>

    <PackageId>Dignus.Log</PackageId>
    <Title>Dignus.Log</Title>
    <Version>3.0.0</Version>

    <Copyright>© 2021–2026 EomTaeWook. Released under the MIT License.</Copyright>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>Dignus.Log.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageProjectUrl>https://github.com/EomTaeWook/Dignus.Log</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/EomTaeWook/Dignus.Log</RepositoryUrl>
    
    <Description>C# logging library with synchronous and asynchronous loggers, configurable formatting, and console and file targets.</Description>
    <PackageTags>logging;logger;async;console;file;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dignus" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DignusLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\publish\Dignus.Log.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\publish\Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release' and '$(SolutionName)' == 'Dignus.Log'">
    <Exec Command="xcopy /S/Y &quot;$(TargetDir)*.dll&quot; &quot;$(SolutionDir)publish\dll\$(TargetFramework)\&quot;" />
  </Target>

  <Target Name="PostPack" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' and '$(SolutionName)' == 'Dignus.Log'">
    <Exec Command="xcopy /Y &quot;$(OutputPath)$(PackageId).$(Version).nupkg&quot; &quot;$(SolutionDir)publish\nuget\&quot;" />
  </Target>
</Project>
